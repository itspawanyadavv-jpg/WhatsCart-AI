# DRC Live Store Integration (Option 2: Hybrid Standalone + Live DRC Sync)
DRC_API_BASE_URL=https://13-206-156-137.sslip.io
DRC_SYNC_ON_STARTUP=true
DRC_INCLUDE_LOCAL_STAPLES=true

# LLM Entity Extraction (leave keys blank to run built-in deterministic Hinglish NLP parser)
LLM_PROVIDER=AUTO
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Gateway (SIMULATOR | META | TWILIO)
WHATSAPP_PROVIDER=SIMULATOR
WHATSAPP_VERIFY_TOKEN=drc-whatsapp-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay Payment Links (leave blank to use interactive UPI demo + upi:// intent URI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MERCHANT_UPI_ID=drcgenstore@okicici
PUBLIC_BASE_URL=http://localhost:8090

# Production Security Guards (set STRICT_WEBHOOK_VERIFICATION=true & ALLOW_SIMULATE_PAY=false in prod)
STRICT_WEBHOOK_VERIFICATION=false
ALLOW_SIMULATE_PAY=true
ADMIN_API_KEY=

